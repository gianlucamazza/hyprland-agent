# OpenAI (needed when using --brain openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Moonshot Kimi (needed when using --brain kimi) — OpenAI-compatible
# Get a key at: https://platform.moonshot.ai/
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2.6

# Groq (needed when using --brain groq) — OpenAI-compatible
# Get a key at: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# Together AI (needed when using --brain together) — OpenAI-compatible
# Get a key at: https://api.together.xyz/
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8

# Z.AI / GLM-4.6V (needed when using --brain zai) — OpenAI-compatible
# Get a key at: https://z.ai/
ZAI_API_KEY=
ZAI_MODEL=glm-4.6v

# Qwen via Alibaba DashScope (needed when using --brain qwen) — OpenAI-compatible
# Get a key at: https://dashscope.aliyuncs.com/
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3-vl-235b-a22b-instruct

# Anthropic is handled via OAuth — set one of:
#   CLAUDE_CODE_OAUTH_TOKEN  — long-lived token from `claude setup-token`
#   ~/.claude/.credentials.json  — auto-refreshed by Claude Code (fallback)
# No ANTHROPIC_API_KEY needed for subscription plans.
ANTHROPIC_MODEL=claude-opus-4-7
